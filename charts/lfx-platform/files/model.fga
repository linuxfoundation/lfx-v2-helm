model
  schema 1.1

# Each change to this authorization model should be accompanied by a version
# bump in charts/lfx-platform/templates/openfga/model.yaml. Recommended
# versioning guidelines:
#   - major: Modifications, deletions, or additions of type
#   - minor: Additions or deletions of relations
#   - patch: Modifications of define
#
# Changes to @fgadoc:jtbd, @fgadoc:alias, or @fgadoc:hide annotations are
# documentation only and do NOT require a version bump.
#
# Do NOT add @fgadoc:jtbd lines manually. These are updated by the
# `populate-jtbds` skill by analyzing live RuleSets and API docs.
# @fgadoc:hide and @fgadoc:alias tags are managed manually.

# @fgadoc:hide
type user

# @fgadoc:hide
type team
  relations
    # @fgadoc:jtbd Accept, reject & reopen formation checklist items
    # @fgadoc:jtbd Create a B2B organization
    # @fgadoc:jtbd Manage survey exclusions & validate email templates
    # @fgadoc:jtbd Trigger a data reindex
    # @fgadoc:jtbd View & manage survey templates
    define member: [user]

type project
  relations
    define parent: [project]
    # global_* tuples are written to every eligible project to quickly check
    # global permissions without traversing the project hierarchy.
    # Deliberately no "from parent", because cascading would prevent
    # withholding a grant from an individual project. That withholding is only
    # actually achieved for global_writer and global_auditor; global_owner and
    # global_marketing_ops reach descendants by other routes, explained where
    # they are defined below.
    #
    # The global_ prefix is load-bearing: it is what marks a relation's team
    # grants as fully reconcilable, so renaming one without the prefix would
    # silently make its grants permanent. See lfx-v2-fga-sync
    # (docs/fga-sync-contract.md) for the reconcile behavior itself.
    # @fgadoc:hide
    define global_owner: [team#member]
    # @fgadoc:hide
    define global_writer: [team#member]
    # @fgadoc:hide
    define global_auditor: [team#member]
    # Named global_ so its team grants can be reconciled, not for the
    # non-cascading behavior the other three have: it composes into
    # marketing_auditor, which cascades, so it reaches every descendant of any
    # project it is written to and cannot be withheld — the rollout must treat
    # it as exempt. Withholding it later would need a guard relation first, as
    # writer and auditor have. The cascade is asserted in tests/model.fga.yaml.
    # @fgadoc:hide
    define global_marketing_ops: [team#member]
    # `[team#member]` and `or owner from parent` can both be removed once all
    # global teams have been rolled out to `global_owner`. Sequence the
    # `global_owner` backfill before or atomically with dropping them, so
    # `owner` never goes dark on a project mid-migration — and drop the
    # `owner from parent` fallback *before or with* removing the ROOT tuples,
    # never after: in that window `owner` still cascades while `global_owner`
    # is already written per project, so a team withheld from a project class
    # would reach it through a covered ancestor with the ROOT grant that used
    # to mask the gap already gone.
    #
    # Dropping `owner from parent` closes the `owner` cascade but not the write
    # and read access it confers: `owner` feeds `writer`, and a direct `writer`
    # grant is deliberately allowed to cascade. So `global_owner`, like
    # `global_marketing_ops`, cannot be withheld from an individual project
    # even after the migration. tests/model.fga.yaml asserts that a global
    # ownership grant on a parent reaches the child's write and read guards, the
    # part that survives dropping the fallback.
    # @fgadoc:jtbd Delete a project
    define owner: [team#member] or global_owner or owner from parent
    # @fgadoc:jtbd Create & update a project
    # @fgadoc:jtbd Manage project links, folders & documents
    # @fgadoc:jtbd Create project committees & Groups.io services
    # @fgadoc:jtbd Create a vote poll
    # @fgadoc:jtbd Update formation checklist items
    define writer: [user] or owner or writer from parent
    define mentorship_program_admin: [user]
    define mentorship_program_creator: writer or mentorship_program_admin
    # @fgadoc:jtbd View project settings
    # @fgadoc:jtbd View formation checklist & activity feed
    define auditor: [user, team#member] or executive_director or writer or auditor from parent
    # The `writer` and `auditor` grants have diverged from `writer_guard`/
    # `auditor_guard` in order to change cascading permissions in a backwards
    # compatible way (directly-granted `writer`/`auditor` are allowed to
    # cascade, but globally-inherited access cannot).
    #
    # The `_guard` suffix on the relation name does not follow the naming
    # convention used elsewhere in this model. Endpoints must guard on this
    # relation, not on the `auditor`/`writer` relations that are granted to
    # users. For the purpose of render-permissions, consider this a single,
    # direct-grant column shared with the non-`_guard` suffix.
    define writer_guard: writer or global_writer
    define auditor_guard: auditor or global_auditor
    # The meeting_coordinator relation identifies a user who can manage any meeting
    # for a given project.
    define meeting_coordinator: [user]
    # Guarded directly by gateway rules rather than through `writer`, so it
    # composes the guard explicitly: left as bare `writer` it would keep
    # working until the ROOT grants are removed and then fail.
    # @fgadoc:jtbd Create meetings & past meetings
    define meetings_creator: writer_guard or meeting_coordinator
    # executive_director identifies a user with the executive director role for a project,
    # as assigned by the project-service. executive_directors are auditors of the project.
    define executive_director: [user]
    # marketing_ops (and every reference to it below, in campaign_manager and
    # marketing_auditor) can be removed entirely once team:marketing-ops has
    # been rolled out to global_marketing_ops — it is not folded into
    # global_marketing_ops itself the way owner absorbs global_owner, since
    # nothing else needs to keep cascading through it in the meantime.
    # @fgadoc:hide
    define marketing_ops: [team#member] or marketing_ops from parent
    # marketing_auditor identifies a user with read access to marketing dashboards
    # and campaigns for a project. The relation itself cascades from parent
    # projects via "marketing_auditor from parent" — so it doesn't matter
    # whether a user reaches marketing_auditor by direct grant, by being an
    # executive_director, or by being marketing_ops, nor at what level of the
    # project hierarchy that happens: however/wherever they got it, they also
    # have it on every descendant of that project. Contrast this with
    # campaign_manager below, where an executive_director's access does not
    # cascade.
    define marketing_auditor: [team#member] or executive_director or marketing_ops or global_marketing_ops or marketing_auditor from parent
    # @fgadoc:jtbd Connect & manage ad platform accounts
    # @fgadoc:jtbd Test & rotate ad platform credentials
    # @fgadoc:jtbd Create & manage campaign briefs
    # @fgadoc:jtbd Approve a brief for campaign creation
    # @fgadoc:jtbd Manage brief target audiences
    # @fgadoc:jtbd Prefill a brief from an event URL
    # @fgadoc:jtbd Generate AI-written email copy for a brief
    # @fgadoc:jtbd Upload creative assets for ad campaigns
    # @fgadoc:jtbd Launch campaigns across ad platforms
    # @fgadoc:jtbd Pause & resume a campaign
    # @fgadoc:jtbd Pause or remove Google Ads keywords
    # @fgadoc:jtbd View live campaign & keyword performance metrics
    # @fgadoc:jtbd Track campaign creation job status
    # campaign_manager is intentionally the same population as marketing_ops
    # (plus executive_director) — there is no separate campaign-manager grant
    # path. The campaign_manager relation itself does not cascade (we don't
    # want an executive_director grant on a project to flow down to its
    # sub-projects), but marketing_ops, included above, does cascade in its
    # own right — so a marketing_ops grant at ROOT still flows down to every
    # descendant project, making that team campaign_manager there too.
    define campaign_manager: executive_director or marketing_ops or global_marketing_ops
    # Resolves through auditor_guard rather than the bare auditor grant, so
    # global-team staff keep basic project navigation once the ROOT grants go.
    # @fgadoc:jtbd View project details & meeting count
    # @fgadoc:jtbd View project links & folders
    # @fgadoc:jtbd View project documents
    define viewer: [user:*] or auditor_guard or meeting_coordinator

type mentorship_approver_team
  relations
    define member: [user]

type mentorship_program
  relations
    define project: [project]
    define writer: [user] or writer from project or mentorship_program_admin from project
    define mentor: [user]
    define manager: writer or mentor
    define auditor: [user, mentorship_approver_team#member] or manager or auditor from project
    define viewer: [user:*] or auditor

type mentorship_application
  relations
    define mentorship_program: [mentorship_program]
    define mentee: [user]
    define manager: writer from mentorship_program
    define writer: mentee or manager
    define reviewer: manager or mentor from mentorship_program
    define auditor: writer or reviewer

type mentorship_task
  relations
    define mentorship_application: [mentorship_application]
    define assignee: [user]
    define manager: reviewer from mentorship_application
    define auditor: assignee or manager

type committee
  relations
    define member: [user]
    define project: [project]
    # @fgadoc:jtbd Update & delete a committee
    # @fgadoc:jtbd Manage committee members, invites & applications
    # @fgadoc:jtbd Manage committee links, folders & documents
    # @fgadoc:jtbd Generate & edit the committee weekly brief
    # @fgadoc:jtbd Create a committee survey
    define writer: [user] or writer_guard from project
    # @fgadoc:jtbd View committee settings
    define auditor: [user, team#member] or writer or auditor_guard from project or meeting_coordinator from project
    # @fgadoc:jtbd Invite a user to join a committee when join mode is invite_only
    define inviter: member or auditor
    # @fgadoc:jtbd View committee details & weekly brief
    # @fgadoc:jtbd View committee members, invites & applications
    # @fgadoc:jtbd View committee links, folders & documents
    define viewer: [user:*] or member or auditor
    # Set this relation to *self* to enable member access to the roster.
    define committee_for_member_roster_access: [committee]
    # Set this relation to *self* to enable member access to email addresses.
    define committee_for_member_email_access: [committee]
    define roster_viewer: [user:*] or auditor or member from committee_for_member_roster_access
    define email_viewer: auditor or member from committee_for_member_email_access

type committee_invite
  relations
    define committee: [committee]
    # The invitee relation identifies the user who was invited to the committee.
    define invitee: [user]
    # @fgadoc:jtbd View a committee invite
    define viewer: invitee or auditor from committee

# @fgadoc:alias Groups.io Service
type groupsio_service
  relations
    define project: [project]
    # @fgadoc:jtbd Update & delete a Groups.io service
    # @fgadoc:jtbd Create a Groups.io mailing list
    define writer: [user] or writer_guard from project
    # @fgadoc:jtbd View Groups.io service settings
    define auditor: [user] or auditor_guard from project or writer
    # @fgadoc:jtbd View a Groups.io service
    define viewer: [user:*] or auditor

# @fgadoc:alias Mailing List
type groupsio_mailing_list
  relations
    define groupsio_service: [groupsio_service]  # Parent relationship.
    define project: project from groupsio_service # Inherit project permissions.
    define committee: [committee] # Inherit committee permissions.
    # @fgadoc:jtbd Update & delete a Groups.io mailing list
    # @fgadoc:jtbd Manage Groups.io mailing list members
    define writer: [user] or writer from groupsio_service or writer from committee
    # @fgadoc:jtbd View Groups.io mailing list settings
    define auditor: [user] or auditor from groupsio_service or auditor from committee
    # @fgadoc:jtbd View a Groups.io mailing list & members
    # @fgadoc:jtbd View & download Groups.io artifacts
    define viewer: [user:*] or writer or auditor or member
    # @fgadoc:alias Subscriber
    define member: [user]

# Hide this from PERMISSIONS.md until we fold v1_meeting into meeting.
# @fgadoc:hide
# @fgadoc:alias Scheduled Meeting
type meeting
  relations
    define project: [project]
    define committee: [committee]
    # The auditor relation identifies a user who can audit this meeting.
    define auditor: organizer or auditor_guard from project
    # The organizer relation identifies a user who can manage this one meeting.
    # That means they can update the meeting details, invite/uninvite participants, etc.
    define organizer: [user] or meeting_coordinator from project or writer from committee or writer_guard from project
    # The host relation identifies a user who is a host of this meeting.
    # This is different than the organizer relation because an organizer isn't necessarily
    # the user who is hosting the meeting, nor is the host necessarily the one who is
    # organizing the meeting. For example, a host may need to retrieve the Zoom host key
    # but shouldn't be able to update the meeting details.
    define host: [user] or auditor
    # The participant relation identifies a user who is a participant in this meeting.
    # This can either mean they are invited to the meeting or they attended the meeting
    # without being invited. In either case, they are a participant of that meeting.
    # Note that committee members are not automatically participants of meetings,
    # because the backend service needs to only include members from the committee
    # based on the voting status filters of that meeting. That is managed by the backend
    # services and therefore can't be a relationship in the authorization model.
    define participant: [user] or host
    # The viewer relation identifies a user who can view this meeting.
    # If the meeting is public, then any user can view it; but if it is private, then
    # only certain privileged users can view it.
    define viewer: [user:*] or participant or organizer or auditor

# @fgadoc:hide
type meeting_attachment
  relations
    define meeting: [meeting]
    define writer: organizer from meeting
    define auditor: writer or auditor from meeting
    define participant: participant from meeting
    define viewer: [user:*] or participant or writer or auditor

# Hide this from PERMISSIONS.md until we fold v1_meeting into meeting.
# @fgadoc:hide
type past_meeting
  relations
    define project: [project]
    define committee: [committee]
    # The meeting relation identifies the meeting that this past meeting was created from.
    # Note: it is possible that the meeting no longer exists, so having permissions on the
    # meeting become obsolete if the meeting is deleted.
    define meeting: [meeting]
    # The auditor relation identifies a user who can audit this meeting.
    define auditor: organizer or auditor_guard from project or auditor from meeting
    # The organizer relation identifies a user who can manage this one past meeting.
    # That means they can update the past meeting details, update the participants, etc.
    define organizer: [user] or meeting_coordinator from project or writer_guard from project or organizer from meeting
    # The host relation identifies a user who was a host of this past meeting.
    define host: [user]
    # The invitee relation identifies a participant who was invited to this past meeting.
    define invitee: [user]
    # The attendee relation identifies a participant who attended this past meeting.
    define attendee: [user]
    # The viewer relation identifies a user who can view this past meeting.
    # If the past meeting is public, then any user can view it; but if it is private, then
    # only certain privileged users can view it.
    define viewer: [user:*] or attendee or invitee or host or organizer or auditor

# Hide this from PERMISSIONS.md until we fold v1_meeting into meeting.
# @fgadoc:hide
# The past_meeting_attachment type identifies an attachment of a past meeting.
type past_meeting_attachment
  relations
    define past_meeting: [past_meeting]
    define writer: organizer from past_meeting
    define auditor: writer or auditor from past_meeting
    define participant: host from past_meeting or invitee from past_meeting or attendee from past_meeting
    define viewer: [user:*] or participant or writer or auditor

# The following v1 meeting types support read-only, indexer-only data
# being synced from LFX v1. At this time, they are *distinct types*
# from the main types above. This encapsulation will make it easier to
# eventually sunset all such v1 tuples when the data is migrated into
# the core data models (as this will result in new UUIDs, new relations
# would have been needed, even if the relation names had been reused
# for the v1 entities).
#
# *All relations are as described in `meeting`, unless otherwise
# noted.*
# @fgadoc:alias Scheduled Meeting
type v1_meeting
  relations
    define project: [project]
    define committee: [committee]
    # @fgadoc:jtbd View a meeting registrant
    define auditor: organizer or auditor_guard from project
    # No explicit [user] relation for organizer in v1.
    # @fgadoc:jtbd Update & delete meetings & occurrences
    # @fgadoc:jtbd Manage meeting registrants & invitations
    # @fgadoc:jtbd Manage meeting attachments
    define organizer: meeting_coordinator from project or writer from committee or writer_guard from project
    define host: [user] or auditor
    define participant: [user] or host
    # @fgadoc:jtbd View a meeting & join link
    # @fgadoc:jtbd Submit a meeting RSVP & download attachments
    # @fgadoc:jtbd Register for a public meeting
    # @fgadoc:jtbd View meeting registrants & RSVPs
    define viewer: [user:*] or participant or organizer or auditor

# *All relations are as described in `past_meeting`, unless otherwise noted.*
# @fgadoc:alias Past Meeting
type v1_past_meeting
  relations
    define project: [project]
    define committee: [committee]
    define meeting: [v1_meeting]
    define auditor: organizer or auditor_guard from project or auditor from meeting
    # No explicit [user] relation for organizer in v1.
    # @fgadoc:jtbd Update & delete past meetings & summaries
    # @fgadoc:jtbd Manage past meeting participants & attachments
    define organizer: meeting_coordinator from project or writer_guard from project or organizer from meeting
    # The host relation identifies a user who was a host of this past meeting.
    # It is used to gate conditional access to recordings, transcripts, and AI summaries
    # via the self-referential flag tuples below.
    define host: [user]
    define invitee: [user]
    define attendee: [user]
    # @fgadoc:jtbd View a past meeting & attachments
    # @fgadoc:jtbd View past meeting participants
    define viewer: [user:*] or attendee or invitee or host or organizer or auditor
    # Per-artifact conditional access — recording.
    # `participant` access level means invitee+attendee (both can view).
    # Self-referential flag tuple: write relation(object=v1_past_meeting:<id>, user=v1_past_meeting:<id>)
    # on the appropriate relation(s) to grant that role access to the recording.
    define past_meeting_for_participant_recording_view: [v1_past_meeting]
    define past_meeting_for_attendee_recording_view: [v1_past_meeting]
    define past_meeting_for_host_recording_view: [v1_past_meeting]
    # @fgadoc:jtbd View past meeting recordings
    define recording_viewer: [user:*] or organizer or auditor or invitee from past_meeting_for_participant_recording_view or attendee from past_meeting_for_attendee_recording_view or host from past_meeting_for_host_recording_view
    # Per-artifact conditional access — transcript.
    # Self-referential flag tuple: write relation(object=v1_past_meeting:<id>, user=v1_past_meeting:<id>)
    # on the appropriate relation(s) to grant that role access to the transcript.
    define past_meeting_for_participant_transcript_view: [v1_past_meeting]
    define past_meeting_for_attendee_transcript_view: [v1_past_meeting]
    define past_meeting_for_host_transcript_view: [v1_past_meeting]
    # @fgadoc:jtbd View past meeting transcripts
    define transcript_viewer: [user:*] or organizer or auditor or invitee from past_meeting_for_participant_transcript_view or attendee from past_meeting_for_attendee_transcript_view or host from past_meeting_for_host_transcript_view
    # Per-artifact conditional access — AI summary.
    # Self-referential flag tuple: write relation(object=v1_past_meeting:<id>, user=v1_past_meeting:<id>)
    # on the appropriate relation(s) to grant that role access to the AI summary.
    define past_meeting_for_participant_summary_view: [v1_past_meeting]
    define past_meeting_for_attendee_summary_view: [v1_past_meeting]
    define past_meeting_for_host_summary_view: [v1_past_meeting]
    # @fgadoc:jtbd View past meeting AI summaries
    define ai_summary_viewer: [user:*] or organizer or auditor or invitee from past_meeting_for_participant_summary_view or attendee from past_meeting_for_attendee_summary_view or host from past_meeting_for_host_summary_view

type vote
  relations
    define committee: [committee]
    define project: [project]
    # @fgadoc:jtbd Update, enable & delete a vote
    # @fgadoc:jtbd Extend a vote & resend notifications
    define writer: writer_guard from project or writer from committee
    # `auditor` has access to participants, `viewer` does not.
    define auditor: writer or auditor_guard from project or auditor from committee
    # @fgadoc:jtbd Cast a vote response
    define participant: [user]
    # @fgadoc:jtbd View vote polls & vote responses
    define viewer: [user:*] or auditor or participant
    define vote_for_participant_result_access: [vote] # Set this relation to *self* to enable access.
    # `results_viewer` is not for viewing the actual related `vote_response`
    # objects, but rather for an aggregate summary which can be made
    # optionally public.
    # @fgadoc:jtbd View vote results
    define results_viewer: [user:*] or auditor or participant from vote_for_participant_result_access

type vote_response
  relations
    define vote: [vote]
    # `owner` is the user who cast this response.
    # @fgadoc:alias Voter
    # @fgadoc:jtbd Submit & update a vote response
    define owner: [user]
    # We don't need a separate `writer` relation defined as just `owner`:
    # we use the `owner` relation directly in our access checks.
    # @fgadoc:jtbd View a vote response
    define auditor: owner or auditor from vote

type survey
  relations
    define committee: [committee]
    define project: [project]
    # @fgadoc:jtbd Update & delete a survey
    # @fgadoc:jtbd Resend survey emails & manage recipients
    define writer: writer_guard from project or writer from committee
    # `auditor` has access to participants, `viewer` does not.
    # @fgadoc:jtbd Preview survey resend impact
    define auditor: writer or auditor_guard from project or auditor from committee
    define participant: [user]
    # @fgadoc:jtbd View survey details & responses
    define viewer: [user:*] or auditor or participant
    define survey_for_participant_result_access: [survey] # Set this relation to *self* to enable access.
    # `results_viewer` is not for viewing the actual related
    # `survey_response` objects, but rather for an aggregate summary which
    # can be made optionally public.
    define results_viewer: [user:*] or auditor or participant from survey_for_participant_result_access

# @fgadoc:hide
type survey_response
  relations
    define survey: [survey]
    # `owner` is the user who cast this response.
    # @fgadoc:alias Respondent
    define owner: [user]
    # We don't need a separate `writer` relation defined as just `owner`:
    # we use the `owner` relation directly in our access checks.
    define auditor: owner or auditor from survey

# @fgadoc:alias B2B Organization
# The b2b_org type represents a Salesforce Account (B2B company). The UID is
# an invertible UUID v8 encoded from the Salesforce Account SFID.
# global_org_admin is written to every b2b_org at creation time by the member
# service, providing writer (and transitively auditor) access to all org admins
# without requiring a hierarchical root object.
type b2b_org
  relations
    # @fgadoc:hide
    define global_org_admin: [team#member]
    define owner: [user]
    # @fgadoc:jtbd Update org details & access settings
    # @fgadoc:jtbd Manage membership committee seat assignments
    # @fgadoc:jtbd Manage org workspaces & workspace projects
    define writer: [user] or owner or global_org_admin or writer from parent or writer from child
    # writer and auditor both cascade transitively up and down the hierarchy via
    # parent/child (LFXV2-3029) — an editor on any organization in a connected
    # parent-child-sibling group is an editor on every member of that group,
    # matching the auditor traversal below.
    # @fgadoc:jtbd View org details, settings & committee seats
    # @fgadoc:jtbd View org workspaces & workspace projects
    define auditor: [user, team#member] or writer or auditor from parent or auditor from child or key_contact from membership
    # parent is included to model company subsidiaries (a b2b_org may have a
    # parent b2b_org in Salesforce).
    define parent: [b2b_org]
    # The following are reverse "downward" relations — the parent holds a
    # reference to its children. This is intentional for userset traversal
    # but introduces a cross-type dependency; be wary of cycles if adding
    # further reverse relations that reference b2b_org from child types.
    define child: [b2b_org]
    define membership: [project_membership]
    define key_contact: key_contact from membership

# @fgadoc:alias Project Membership
# The project_membership type represents a Salesforce Asset record: one active
# (or expired) membership term for a b2b_org within a project. Access is derived
# from the caller's relationship to the parent b2b_org or parent project.
# writer is intentionally scoped to b2b_org only: project-level writers (LF staff)
# can audit memberships but cannot create or modify them.
type project_membership
  relations
    define b2b_org: [b2b_org]
    define project: [project]
    # @fgadoc:jtbd Create, update & delete key contacts
    define writer: writer from b2b_org
    # @fgadoc:jtbd View project membership & key contacts
    define auditor: writer or auditor from b2b_org or auditor_guard from project
    define key_contact: [user]

# The `crowdfunding_initiative` type models Crowdfunding's whole authorization
# surface: an initiative may hang off a project or a b2b_org (exclusive
# attribution; a personal initiative has neither), and writers there can
# manage it. See lfx-crowdfunding's
# backend/docs/rewrite/12-fga-authorization-model.md for the full design.
# Hide this from PERMISSIONS.md until CF sits behind Heimdall and
# RuleSets referencing these relations exist. `@fgadoc:jtbd` lines must
# never be hand-authored ahead of a RuleSet.
# @fgadoc:hide
type crowdfunding_initiative
  relations
    # Exclusive attribution; personal initiatives have neither.
    define project: [project]
    define b2b_org: [b2b_org]
    # @fgadoc:alias Creator
    define owner: [user]
    define writer: owner or writer from project or writer from b2b_org
    define viewer: [user:*] or writer
